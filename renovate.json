{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "baseBranches": ["main"],
    "timezone": "America/Toronto",
    "schedule": [
        "* 19-23 * * 5",
        "* 0-2 * * 6"
    ],
    "automerge": true,
    "automergeType": "pr",
    "automergeStrategy": "squash",
    "enabledManagers": ["docker-compose", "github-actions", "gitlabci"],
    "packageRules": [
        {
            "matchUpdateTypes": ["major"],
            "matchBaseBranches": "main",
            "enabled": false
        },
        {
            "matchUpdateTypes": ["digest"],
            "matchBaseBranches": "main",
            "matchManagers": ["docker-compose"],
            "enabled": false
        },
        {
            "matchManagers": ["docker-compose"],
            "groupName": "services deps",
            "groupSlug": "services-deps",
            "commitMessageTopic": "{{depName}}"
        },
        {
            "matchManagers": ["github-actions"],
            "groupName": "github deps",
            "groupSlug": "github-deps",
            "commitMessageTopic": "{{depName}}"
        },
        {
            "matchManagers": ["gitlabci"],
            "groupName": "gitlab deps",
            "groupSlug": "gitlab-deps",
            "commitMessageTopic": "{{depName}}"
        }
    ]
}